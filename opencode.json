{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-sonnet-4-5",
  "small_model": "github-copilot/gpt-5.4-mini",
  "instructions": ["AGENTS.md"],
  "compaction": {
    "auto": true,
    "tail_turns": 3
  },
  "agent": {
    "AS-Github": {
      "model": "github-copilot/claude-sonnet-4-5",
      "mode": "primary",
      "description": "GitHub Copilot paid model — use when tokens available"
    },
    "AS-Deepseek": {
      "model": "opencode/deepseek-v4-flash-free",
      "mode": "primary",
      "description": "Free opencode model — fallback when GitHub tokens run out"
    },
    "title": {
      "model": "github-copilot/gpt-5.4-mini"
    },
    "summary": {
      "model": "github-copilot/gpt-5.4-mini"
    }
  }
}
